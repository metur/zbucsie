# Sensible .gitignore for this Python/Flask repo

# Python cache and bytecode
__pycache__/
*.py[cod]

# Virtual environments (requested)
.venv/
venv/

# Flask instance folder (requested)
instance/

# Env and secrets
.env
.env.*

# Local DB files
*.db
*.sqlite3

# Test and type-check caches
.pytest_cache/
.mypy_cache/

# IDE/editor
.idea/
.vscode/

# Logs and OS files
*.log
.DS_Store
Thumbs.db
